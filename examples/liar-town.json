{
  "name": "liar-town",
  "world": "town",
  "world_options": { "sign": "CORNER SHOP" },
  "hook": { "text": "In this town… *lies shrink you*" },
  "cast": [
    { "id": "narrator", "narrator": true, "voice": "en-US-ChristopherNeural", "rate": "-4%", "color": "#7CF5FF" },
    { "id": "mia", "voice": "en-US-AnaNeural", "rate": "+6%", "color": "#FF7CC3",
      "look": { "style": "hoodie", "outfit": "#FF7CC3", "hair": "#3B2416", "female": true, "hairStyle": "bun" } },
    { "id": "mom", "voice": "en-US-AriaNeural", "rate": "+4%", "color": "#FFD400",
      "look": { "style": "kurti", "outfit": "#7E57C2", "hair": "#2B1A12", "female": true, "hairStyle": "long", "glasses": true } },
    { "id": "dad", "voice": "en-US-GuyNeural", "rate": "+6%", "color": "#8CFF7A", "pos": [24, 1],
      "look": { "style": "suit", "outfit": "#26A69A", "tie": "#FFD400", "hat": "cap", "hatColor": "#1E88E5", "mustache": true } }
  ],
  "beats": [
    { "say": "narrator", "text": "In this town, every time you lie, you shrink.", "scene": "orbit" },
    { "say": "mom", "text": "Mia, did you finish your homework?", "scene": "closeup:mom", "face": { "mom": "mia" } },
    { "say": "mia", "text": "Yes, Mom! I finished it yesterday!", "scene": "closeup:mia", "size": { "mia": 0.72 }, "pose": { "mia": { "cheer": true } } },
    { "move": { "dad": [4.6, 0.6] }, "walk": 2.2, "scene": "wide", "face": { "mom": "camera" } },
    { "say": "dad", "text": "Mia... why are you so small?", "scene": "close", "face": { "dad": "mia" }, "pose": { "dad": { "shock": true } } },
    { "say": "mia", "text": "I'm not small. I'm just far away.", "scene": "low:mia", "size": { "mia": 0.45 }, "sfx": ["laugh"] },
    { "say": "narrator", "text": "She was not far away.", "scene": "top" },
    { "say": "mom", "text": "Mia. The truth.", "scene": "closeup:mom", "face": { "mom": "mia" }, "pose": { "mom": { "angry": true } } },
    { "say": "mia", "text": "Okay! I didn't do it! I played games all night!", "scene": "wide", "size": { "mia": 1 }, "pose": { "mia": { "shock": true } } },
    { "say": "dad", "text": "See? The truth makes you big.", "scene": "close", "pose": { "dad": { "point": true } } },
    { "say": "mia", "text": "Can I lie just a little?", "scene": "closeup:mia", "pose": { "mia": { "sad": true } }, "size": { "mia": 0.9 } },
    { "say": "narrator", "text": "Follow for more stories from this town.", "scene": "orbit",
      "cta": { "line": "Follow for more", "value": "@yourchannel" }, "pose": { "mia": { "dance": true }, "dad": { "dance": true }, "mom": { "wave": true } } }
  ]
