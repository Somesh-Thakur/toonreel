    { "say": "zoe", "text": "Ma'am, he also thinks you are the best teacher ever.", "scene": "close:zoe", "face": { "zoe": "teacher" }, "pose": { "zoe": { "point": true } } },
    { "say": "teacher", "text": "Nice try. The test is still on.", "scene": "closeup:teacher", "face": { "teacher": "camera" }, "pose": { "teacher": { "wave": true } } },
